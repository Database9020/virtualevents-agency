---
// Generated brand thumbnail for a blog post — no photography, no AI imagery.
// Solid dark card + accent gradient, the post's own title set in Inter, and
// one of three geometric motifs reused from the site's service icons. Purely
// data-driven (title + tag + slug) so every new post gets one automatically.
import { wrapTitle, motifForSlug, type Motif } from '../lib/thumbnail';

interface Props {
  title: string;
  tag?: string;
  seed: string;
  class?: string;
}

const { title, tag = 'Virtual Events', seed, class: className = '' } = Astro.props;

const lines = wrapTitle(title);
const motif: Motif = motifForSlug(seed);

const MOTIF_PATHS: Record<Motif, string> = {
  calendar: 'M3 5h18v16H3zM3 10h18M8 3v4M16 3v4',
  monitor: 'M3 4h18v13H3zM8 21h8M12 17v4',
  repeat: 'M17 2l4 4-4 4M3 11V9a4 4 0 0 1 4-4h14M7 22l-4-4 4-4M21 13v2a4 4 0 0 1-4 4H3',
};

const gradId = `thumb-grad-${seed}`;
const glowId = `thumb-glow-${seed}`;

const lineHeight = 52;
const baseY = 210 + (4 - lines.length) * lineHeight;
---

<svg
  class={`post-thumb ${className}`}
  viewBox="0 0 800 450"
  role="img"
  aria-label={title}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={gradId} x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="10%" stop-color="#00FFA3" />
      <stop offset="90%" stop-color="#FAFF00" />
    </linearGradient>
    <radialGradient id={glowId} cx="80%" cy="10%" r="65%">
      <stop offset="0%" stop-color="#00FFA3" stop-opacity="0.22" />
      <stop offset="100%" stop-color="#00FFA3" stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect width="800" height="450" fill="#15171b" />
  <rect width="800" height="450" fill={`url(#${glowId})`} />

  <g transform="translate(540,-46) rotate(-8)" opacity="0.16">
    <path
      d={MOTIF_PATHS[motif]}
      fill="none"
      stroke={`url(#${gradId})`}
      stroke-width="1.1"
      stroke-linecap="round"
      stroke-linejoin="round"
      transform="scale(13.2)"
    />
  </g>

  <text x="48" y="70" font-family="Inter, sans-serif" font-size="21" font-weight="800" letter-spacing="1.5" fill="#8FE24B">
    {tag.toUpperCase()}
  </text>

  <rect x="49" y="92" width="52" height="5" rx="2.5" fill={`url(#${gradId})`} />

  <text font-family="Inter, sans-serif" font-size="42" font-weight="800" fill="#F5F6F7">
    {lines.map((line, i) => (
      <tspan x="48" y={baseY + i * lineHeight}>{line.text}</tspan>
    ))}
  </text>
</svg>

<style>
  .post-thumb {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
