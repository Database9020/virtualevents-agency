---
import Button from './Button.astro';
import { FINAL_CTA_SECTION, SITE } from '../lib/site';
---

<section class="section final-cta">
  <div class="container">
    <div class="card final-cta-card">
      <h2>{FINAL_CTA_SECTION.heading}</h2>
      <p>{FINAL_CTA_SECTION.subheading}</p>
      <Button href={SITE.strategyCallUrl} icon="phone">{FINAL_CTA_SECTION.ctaLabel}</Button>
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding-top: 3rem;
  }

  @media (max-width: 720px) {
    .final-cta {
      padding-top: 2rem;
    }
  }

  .final-cta-card {
    text-align: center;
    padding: 4rem 2rem;
    background: radial-gradient(60% 100% at 50% 0%, rgba(0, 255, 163, 0.12), transparent 70%), var(--color-bg-elevated);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .final-cta-card h2 {
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    max-width: 640px;
  }

  .final-cta-card p {
    color: var(--color-text-muted);
    max-width: 560px;
    font-size: 1.05rem;
  }
</style>
