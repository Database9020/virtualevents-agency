---
// Placeholder client-logo marquee. The six marks below are generic,
// invented placeholders (not real companies) — swap them for actual
// client logos when they're available. Layout and animation are the
// point of this component, not the specific marks.
const LOGOS = [
  {
    name: 'Northline',
    mark: '<circle cx="16" cy="16" r="9"/><circle cx="16" cy="16" r="2.4" fill="currentColor" stroke="none"/>',
  },
  {
    name: 'Solstice',
    mark: '<path d="M16 4 27 10.5V21.5L16 28 5 21.5V10.5Z"/>',
  },
  {
    name: 'Kestrel',
    mark: '<path d="M6 24V15M16 24V9M26 24V18"/>',
  },
  {
    name: 'Anchorpoint',
    mark: '<path d="M16 4 27 16 16 28 5 16Z"/>',
  },
  {
    name: 'Meridian',
    mark: '<path d="M4 22 11 12 16 18 21 8 28 22Z"/>',
  },
  {
    name: 'Verity',
    mark: '<rect x="6" y="6" width="14" height="14"/><rect x="13" y="13" width="14" height="14"/>',
  },
];

// Three copies in the track + a translateX(-33.333%) animation keeps the
// loop seamless (translating by exactly one copy's width) regardless of
// how wide the viewport is.
const TRACK_LOGOS = [...LOGOS, ...LOGOS, ...LOGOS];
---

<section class="client-logos" aria-label="Companies we've worked with">
  <div class="container client-logos-inner">
    <p class="client-logos-eyebrow">Trusted by teams at</p>

    <div class="marquee">
      <div class="marquee-track">
        {TRACK_LOGOS.map((logo) => (
          <div class="logo-item">
            <svg class="logo-icon" viewBox="0 0 32 32" aria-hidden="true" set:html={logo.mark} />
            <span>{logo.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .client-logos {
    padding: 1.5rem 0 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .client-logos-inner {
    text-align: center;
  }

  .client-logos-eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    opacity: 0.8;
  }

  .marquee {
    position: relative;
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: 3.5rem;
    animation: marquee-scroll 34s linear infinite;
  }

  @media (hover: hover) {
    .marquee:hover .marquee-track {
      animation-play-state: paused;
    }
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-33.3333%);
    }
  }

  .logo-item {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text-faint);
    opacity: 0.55;
    transition: opacity 0.2s ease, color 0.2s ease;
  }

  .logo-item:hover {
    opacity: 1;
    color: var(--color-text-muted);
  }

  .logo-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .logo-item span {
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .client-logos {
      padding: 1.75rem 0 2.75rem;
    }

    .marquee-track {
      gap: 2.25rem;
      animation-duration: 24s;
    }

    .logo-icon {
      width: 22px;
      height: 22px;
    }

    .logo-item span {
      font-size: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
