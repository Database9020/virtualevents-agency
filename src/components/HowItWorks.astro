---
import { HOW_IT_WORKS_SECTION } from '../lib/site';
---

<section class="section how-it-works">
  <div class="container">
    <h2 class="section-heading">{HOW_IT_WORKS_SECTION.heading}</h2>

    <div class="steps-grid">
      {HOW_IT_WORKS_SECTION.steps.map((step) => (
        <div class="card step-card">
          <span class="step-number gradient-text">{step.step}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .steps-grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .step-number {
    font-size: 1.5rem;
    font-weight: 900;
  }

  .step-card h3 {
    margin-top: 0.75rem;
    font-size: 1.15rem;
  }

  .step-card p {
    margin-top: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .steps-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .steps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
