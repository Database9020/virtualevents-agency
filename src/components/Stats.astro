---
import { STATS_SECTION } from '../lib/site';
---

<section class="section stats">
  <div class="container">
    <h2 class="section-heading">{STATS_SECTION.heading}</h2>
    <p class="section-subheading">{STATS_SECTION.subheading}</p>

    <div class="stats-grid">
      {STATS_SECTION.stats.map((stat) => (
        <div class="card stat-card">
          <p class="stat-value gradient-text">{stat.value}</p>
          <p class="stat-label">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats-grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .stat-card {
    text-align: center;
  }

  .stat-value {
    font-size: 2.75rem;
    font-weight: 800;
  }

  .stat-label {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
