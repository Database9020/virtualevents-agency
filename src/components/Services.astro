---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { SERVICES, SERVICES_SECTION, SITE } from '../lib/site';
---

<section class="section services" id="services">
  <div class="container">
    <span class="eyebrow center">{SERVICES_SECTION.eyebrow}</span>
    <h2 class="section-heading">{SERVICES_SECTION.heading}</h2>
    <p class="section-subheading">{SERVICES_SECTION.subheading}</p>
    <p class="positioning-statement">{SITE.defaultDescription}</p>

    <div class="services-grid">
      {SERVICES.map((service) => (
        <div class="card service-card">
          <Icon name={service.icon as any} size={30} class="service-icon" />
          <h3>{service.title}</h3>
          <ul>
            {service.items.map((item) => (
              <li>
                <span class="dot"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="services-footnote">{SERVICES_SECTION.footnote}</p>

    <div class="services-cta card">
      <h3>{SERVICES_SECTION.ctaHeading}</h3>
      <p>{SERVICES_SECTION.ctaBody}</p>
      <Button href={SITE.strategyCallUrl} icon="phone">Book A Free Strategy Call</Button>
      <p class="cta-note">{SERVICES_SECTION.ctaNote}</p>
    </div>
  </div>
</section>

<style>
  .services {
    padding-bottom: 3rem;
  }

  .eyebrow.center {
    display: block;
    text-align: center;
    margin-bottom: 1rem;
  }

  .positioning-statement {
    max-width: 640px;
    margin: 1rem auto 0;
    text-align: center;
    color: var(--color-text-faint);
    font-size: 0.9rem;
  }

  .services-grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .service-icon {
    color: var(--accent-green);
    margin-bottom: 1.25rem;
  }

  .service-card h3 {
    font-size: 1.3rem;
    margin-bottom: 1.25rem;
  }

  .service-card li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    color: var(--color-text-muted);
    padding: 0.4rem 0;
  }

  .service-card .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-green);
    margin-top: 0.6rem;
    flex-shrink: 0;
  }

  .services-footnote {
    text-align: center;
    color: var(--color-text-faint);
    margin-top: 2rem;
    font-size: 0.95rem;
  }

  .services-cta {
    margin-top: 3.5rem;
    text-align: center;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    background: var(--color-bg-elevated);
  }

  .services-cta h3 {
    font-size: 1.75rem;
  }

  .services-cta p {
    color: var(--color-text-muted);
    max-width: 480px;
  }

  .cta-note {
    font-size: 0.85rem;
    color: var(--color-text-faint);
  }

  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .services {
      padding-bottom: 2rem;
    }
  }
</style>
